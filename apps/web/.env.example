# Use a separate Auth0 application and API for each environment. Never commit real values.
AUTH0_DOMAIN=YOUR_DEVELOPMENT_TENANT.auth0.com
AUTH0_CLIENT_ID=YOUR_DEVELOPMENT_WEB_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_DEVELOPMENT_WEB_CLIENT_SECRET
AUTH0_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
AUTH0_AUDIENCE=https://api.dev.wealth-os.example

APP_BASE_URL=http://localhost:3000
WEALTHOS_API_BASE_URL=http://localhost:8080

# Production must use an authenticated TLS URL (rediss://) and an isolated namespace.
REDIS_URL=redis://localhost:6379
REDIS_SESSION_PREFIX=wealthos:dev:session:
